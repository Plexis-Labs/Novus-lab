# Environment mode. Controls logging verbosity and safety checks.
# Values: development | staging | production
# [REQUIRED]
NOVUS_ENV=development

# Log level. Uses standard severity levels.
# Values: debug | info | warn | error | fatal

NOVUS_LOG_LEVEL=debug

# Which AI provider to use for Lab generation.
# Set to "mock" to run the full demo flow without internet or API keys.
# Values: openai | anthropic | gemini | mock
# [MOCK-OK]
NOVUS_AI_PROVIDER=mock

# OpenAI API key. Required when NOVUS_AI_PROVIDER=openai.
# [OPTIONAL]
NOVUS_OPENAI_API_KEY=

# Anthropic API key. Required when NOVUS_AI_PROVIDER=anthropic.
# [OPTIONAL]
NOVUS_ANTHROPIC_API_KEY=

# Google Gemini API key. Required when NOVUS_AI_PROVIDER=gemini.
# [OPTIONAL]
NOVUS_GEMINI_API_KEY=

# Maximum tokens for generation requests.
# [OPTIONAL]
NOVUS_AI_MAX_TOKENS=4096

# Storage backend adapter.
# Values: indexeddb | memory | mock
# Set to "mock" to use in-memory storage during development/tests.
# [MOCK-OK]
NOVUS_STORAGE_ADAPTER=mock


# Extension ID assigned by Chrome after loading unpacked.
# Populate this after your first local load.
# [OPTIONAL]
NOVUS_EXTENSION_ID=

# Enable the experimental bundle validation pipeline.
# Values: true | false
# [OPTIONAL]
NOVUS_ENABLE_BUNDLE_VALIDATION=true

# Enable the Sensitive Context Firewall.
# Recommended: always true in production.
# [OPTIONAL]
NOVUS_ENABLE_SENSITIVE_FIREWALL=true


# Set to "true" when running inside CI. Disables interactive prompts.
# [OPTIONAL]
CI=false
