{
  "name": "@novus/contracts",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src/",
    "lint:fix": "eslint . --fix",
    "test": "vitest run ",
    "test:unit": "vitest run tests/unit",
    "test:contract": "vitest run tests/contract",
    "test:serialization": "vitest run tests/serialization",
    "test:compatibility": "vitest run tests/compatibility",
    "test:integration": "vitest run tests/integration",
    "test:security": "vitest run tests/security",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@novus/shared": "workspace:*",
    "zod": "^3.23.0",
    "zod-to-json-schema": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "tsup": "^8.0.0",
    "typescript": "^5.9.3",
    "vitest": "^1.6.1"
  }
}
