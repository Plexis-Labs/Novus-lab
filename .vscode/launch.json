{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug: Extension",
      "type": "chrome",
      "request": "launch",
      "url": "chrome://extensions",
      "userDataDir": "${workspaceFolder}/.chrome-debug-profile",
      "runtimeArgs": [
        "--load-extension=${workspaceFolder}/apps/extension/dist",
        "--allow-failed-policy-fetch-for-test",
        "--disable-extensions-except=${workspaceFolder}/apps/extension/dist"
      ],
      "preLaunchTask": "build:extension",
      "webRoot": "${workspaceFolder}/apps/extension/src",
      "sourceMapPathOverrides": {
        "webpack:///./*": "${workspaceFolder}/apps/extension/src/*"
      },
      "presentation": {
        "group": "App",
        "order": 1
      }
    },
    {
      "name": "Debug: AI Gateway",
      "type": "node",
      "request": "launch",
      "autoAttachChildProcesses": true, 
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter=@novus/ai-platform",
        "dev"
      ],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "skipFiles": [
        "<node_internals>/**",
        "**/node_modules/**"
      ],
      "presentation": {
        "group": "App",
        "order": 2
      }
    },
    {
      "name": "Debug: Demo Site",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/apps/demo/src",
      "preLaunchTask": "dev:demo",
      "presentation": {
        "group": "App",
        "order": 3
      }
    },
    {
      "name": "Debug: Unit Tests",
      "type": "node",
      "request": "launch",
      "autoAttachChildProcesses": true,
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "vitest",
        "run"
      ],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "skipFiles": [
        "<node_internals>/**",
        "**/node_modules/**"
      ],
      "presentation": {
        "group": "Test",
        "order": 1
      }
    },
    {
      "name": "Debug: Playwright",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "playwright",
        "test",
        "--headed",
        "--debug"
      ],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "skipFiles": [
        "<node_internals>/**"
      ],
      "presentation": {
        "group": "Test",
        "order": 2
      }
    }
  ],
  "compounds": [
    {
      "name": "Debug: Full Stack (Extension + Gateway)",
      "configurations": [
        "Debug: Extension",
        "Debug: AI Gateway"
      ],
      "presentation": {
        "group": "Full Stack",
        "order": 1
      }
    }
  ]
}