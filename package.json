{
  "name": "novus",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI-Generated Persistent Micro-Applications for the Modern Web",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.9.0",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:extension": "turbo run dev --filter=@novus/extension",
    "dev:ai-platform": "turbo run dev --filter=@novus/ai-platform",
    "dev:docs": "turbo run dev --filter=@novus/docs",
    "build": "turbo run build",
    "build:extension": "turbo run build --filter=@novus/extension",
    "build:packages": "turbo run build --filter=./packages/*",
    "build:clean": "pnpm clean && pnpm build",
    "test:watch": "turbo run test:watch --parallel",
    "test:coverage": "turbo run test:coverage",
    "test:ui": "turbo run test:ui",
    "e2e": "turbo run e2e",
    "e2e:headed": "turbo run e2e:headed",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yaml,yml,css}\" --ignore-path .prettierignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yaml,yml,css}\" --ignore-path .prettierignore",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rimraf node_modules/.cache .turbo coverage",
    "clean:deep": "pnpm clean && find . -name 'node_modules' -not -path './.git/*' -prune -exec rm -rf '{}' + 2>/dev/null; pnpm install",
    "generate:json-schema": "turbo run generate:json-schema --filter=@novus/contracts",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "ci": "pnpm install --frozen-lockfile && pnpm build && pnpm check",
    "prepare": "husky",
    "test:snapshots": "vitest run --update",
    "test:compatibility": "turbo run test:compatibility",
    "test:adapters": "turbo run test:adapters",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "test:contract": "turbo run test:contract",
    "test:serialization": "turbo run test:serialization",
    "test:integration": "turbo run test:integration"
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@crxjs/vite-plugin": "2.7.1",
    "@eslint/js": "^9.39.4",
    "@novus/contracts": "workspace:*",
    "@playwright/test": "^1.61.1",
    "@types/chrome": "^0.2.2",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.62.0",
    "@typescript-eslint/parser": "^8.62.0",
    "@vitejs/plugin-react": "catalog:",
    "eslint": "9",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.7.0",
    "husky": "catalog:",
    "lint-staged": "catalog:",
    "prettier": "catalog:",
    "rimraf": "6.0.1",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
